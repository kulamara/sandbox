# ===========================================
# 安全数据分析沙箱项目 - Git忽略文件
# ===========================================

# Python 相关
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境 (重要：不要提交虚拟环境)
venv/
env/
ENV/
env.bak/
venv.bak/
web_interface/venv/
.venv/

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# 操作系统生成的文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE_BIN/

# Docker 相关
.dockerignore

# 日志文件
*.log
logs/
web_interface/*.log

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 环境变量文件 (可能包含敏感信息)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 临时文件
*.tmp
*.temp
temp/
tmp/
*.bak
*.backup

# SSH 密钥和证书 (安全考虑)
*.pem
*.key
id_rsa*
dummy_key/
*.crt
*.csr

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 测试相关
test_results/
.pytest_cache/
.coverage
.nyc_output
coverage/

# Node.js (如果有前端依赖)
node_modules/
.npm
.eslintcache
*.tgz
.yarn-integrity

# 压缩文件
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# 编译文件
*.com
*.class
*.dll
*.exe
*.o

# 配置文件 (包含敏感数据)
config.local.*
secrets.*
.secrets
local_config.*

# 文档构建
docs/_build/
site/

# 特定于项目的忽略
# 注意：以下文件夹包含演示数据，根据需要决定是否提交
# data/              # 取消注释以忽略数据目录
# command_inbox/     # 取消注释以忽略命令收件箱

# 运行时生成的文件
*.pid
*.sock

# 缓存文件
.cache/
*.cache

# 本地测试文件
test_local.*
*_local.*